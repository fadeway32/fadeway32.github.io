<div id="tools">
    <div class="progressbar-top"></div>

    <% if (theme.Music.type == 'APlayer') { %>
        <div class="aplayer"></div>
        <link type="text/css" rel="stylesheet" href="<%- theme.Style.aplayer %>">
        <script type="text/javascript" src="<%- theme.Script.aplayer %>"></script>
        <script type="text/javascript">
            (function () {
                const baseAudio = <%- JSON.stringify(theme.APlayer.audio) %>;
                const aplayer = new APlayer({
                    container: document.querySelector(<%- JSON.stringify(theme.APlayer.container) %>),
                    fixed: <%- theme.APlayer.fixed %>,
                    autoplay: <%- theme.APlayer.autoplay %>,
                    loop: <%- JSON.stringify(theme.APlayer.loop) %>,
                    order: <%- JSON.stringify(theme.APlayer.order) %>,
                    preload: <%- JSON.stringify(theme.APlayer.preload) %>,
                    volume: <%- theme.APlayer.volume %>,
                    mutex: <%- theme.APlayer.mutex %>,
                    lrcType: <%- theme.APlayer.lrcType %>,
                    audio: baseAudio
                });

                const metingType = <%- JSON.stringify(theme.Meting.type) %>;
                const metingId = <%- JSON.stringify(theme.Meting.id) %>;
                const metingServer = <%- JSON.stringify(theme.Meting.server) %>;
                if (metingType === 'playlist' && metingId && typeof fetch === 'function') {
                    const api = 'https://api.i-meto.com/meting/api?server=' +
                        encodeURIComponent(metingServer) +
                        '&type=' + encodeURIComponent(metingType) +
                        '&id=' + encodeURIComponent(metingId) +
                        '&r=' + Date.now();

                    fetch(api, {cache: 'no-store'})
                        .then(function (response) {
                            if (!response.ok) throw new Error('playlist fetch failed');
                            return response.json();
                        })
                        .then(function (tracks) {
                            if (!Array.isArray(tracks) || !tracks.length || typeof aplayer.addAudio !== 'function') return;

                            const existing = {};
                            baseAudio.forEach(function (audio) {
                                if (audio && audio.url) existing[audio.url] = true;
                                if (audio && audio.name) existing[audio.name] = true;
                            });

                            const extraAudio = [];
                            tracks.forEach(function (track) {
                                const audio = {
                                    name: track.name || track.title || 'Audio name',
                                    artist: track.artist || track.author || 'Audio artist',
                                    cover: track.cover || track.pic || '',
                                    url: track.url,
                                    lrc: track.lrc || track.lyric || '',
                                    type: track.type || 'normal'
                                };

                                if (!audio.url || existing[audio.url] || existing[audio.name]) return;
                                existing[audio.url] = true;
                                existing[audio.name] = true;
                                extraAudio.push(audio);
                            });

                            if (extraAudio.length) {
                                aplayer.addAudio(extraAudio);
                            }
                        })
                        .catch(function () {
                        });
                }
            })();
        </script>
    <% } else { %>
        <link type="text/css" rel="stylesheet" href="<%- theme.Style.aplayer %>">
        <script type="text/javascript" src="<%- theme.Script.aplayer %>"></script>
        <script type="text/javascript" src="<%- theme.Script.meting %>"></script>
        <meting-js id="<%- theme.Meting.id %>" lrcshow="<%- theme.Meting.lrcshow %>" server="<%- theme.Meting.server %>"
                   type="<%- theme.Meting.type %>" fixed="<%- theme.Meting.fixed %>"
                   autoplay="<%- theme.Meting.autoplay %>" loop="<%- theme.Meting.loop %>"
                   order="<%- theme.Meting.order %>" preload="<%- theme.Meting.preload %>"
                   volume="<%- theme.Meting.volume %>" mutex="<%- theme.Meting.mutex %>"></meting-js>
    <% } %>
    
    <div class="wrap-right">
        <div class="setting">
            <div class="iconbox favorites" switch="false">
                <span class="iconfont icon-favorites"></span>
                <span class="icontext">关注</span>
            </div>
            <div class="iconbox mode">
                <div class="light">
                    <span class="iconfont icon-daymode"></span>
                    <span class="icontext">浅色模式</span>
                </div>
                <div class="dark">
                    <span class="iconfont icon-nightmode-fill"></span>
                    <span class="icontext">深色模式</span>
                </div>
            </div>
            <a href="javascript:;" target="_self" class="search">
                <div class="iconbox">
                    <span class="iconfont icon-search-menu"></span>
                    <span class="icontext">搜索</span>
                </div>
            </a>
            <div class="iconbox bottom">
                <div style="display: inline-block; transform: rotate(180deg);">
                    <span class="iconfont icon-top"></span>
                </div>
                <span class="icontext">跳至底部</span>
            </div>
        </div>
        <div class="iconbox set">
            <div style="display: inline-block;">
                <span class="iconfont icon-setting"></span>
            </div>
            <span class="icontext">设置</span>
        </div>
        <div class="iconbox top">
            <span class="iconfont icon-top"></span>
            <span class="icontext">返回顶部</span>
        </div>
    </div>
    <div class="loading"></div>
</div>
