<%
const introAudio = theme.APlayer && theme.APlayer.audio && theme.APlayer.audio.length ? theme.APlayer.audio[0] : {};
const autoplayEnabled = theme.APlayer && theme.APlayer.autoplay;
const targetVolume = theme.Meting ? theme.Meting.volume : 0.67;
%>
<div id="tools">
    <div class="progressbar-top"></div>

    <link type="text/css" rel="stylesheet" href="<%- theme.Style.aplayer %>">
    <script type="text/javascript" src="<%- theme.Script.aplayer %>"></script>
    <script type="text/javascript" src="<%- theme.Script.meting %>"></script>
    <meting-js id="<%- theme.Meting.id %>" lrcshow="<%- theme.Meting.lrcshow %>" server="<%- theme.Meting.server %>"
               type="<%- theme.Meting.type %>" fixed="<%- theme.Meting.fixed %>" autoplay="false"
               loop="<%- theme.Meting.loop %>" order="<%- theme.Meting.order %>" preload="<%- theme.Meting.preload %>"
               volume="<%- theme.Meting.volume %>" mutex="<%- theme.Meting.mutex %>"></meting-js>

    <script type="text/javascript">
        (function () {
            var toolsRoot = document.getElementById('tools');
            if (!toolsRoot || typeof APlayer === 'undefined') {
                return;
            }

            var metingElement = toolsRoot.querySelector('meting-js');
            var targetVolume = <%- targetVolume %>;
            var autoplayEnabled = <%- autoplayEnabled %>;
            var introAudio = {
                name: "<%- introAudio.name || '知我' %>",
                artist: "<%- introAudio.artist || '' %>",
                cover: "<%- introAudio.cover || '' %>",
                url: "<%- introAudio.url || '' %>",
                lrc: "<%- introAudio.lrc || '' %>"
            };
            var introIndex = -1;
            var introRemoved = false;
            var metingPlayer = null;
            var initTimer = null;

            function restoreAudio(audio) {
                if (!audio) {
                    return;
                }

                audio.muted = false;
                audio.defaultMuted = false;
                audio.removeAttribute('muted');
                audio.removeAttribute('autoplay');
                audio.volume = targetVolume;
            }

            function attemptPlay(player, muted) {
                if (!player || !player.audio) {
                    return;
                }

                var audio = player.audio;
                if (typeof muted === 'boolean') {
                    audio.muted = muted;
                    audio.defaultMuted = muted;
                    if (muted) {
                        audio.setAttribute('muted', 'muted');
                        audio.setAttribute('autoplay', 'autoplay');
                        audio.volume = 0;
                    }
                }

                var result = audio.play();
                if (result && typeof result.catch === 'function') {
                    result.catch(function () {
                        if (player && player.setUIPaused) {
                            player.setUIPaused();
                        }
                    });
                }
            }

            function startMutedAutoplay(player) {
                if (!player || !player.audio) {
                    return;
                }

                var audio = player.audio;
                audio.muted = true;
                audio.defaultMuted = true;
                audio.setAttribute('muted', 'muted');
                audio.setAttribute('autoplay', 'autoplay');
                audio.volume = 0;

                var clearMute = function () {
                    restoreAudio(audio);
                };

                audio.addEventListener('playing', function () {
                    window.setTimeout(clearMute, 120);
                }, {once: true});

                ['loadedmetadata', 'canplay', 'canplaythrough'].forEach(function (eventName) {
                    audio.addEventListener(eventName, function resumeOnReady() {
                        if (audio.paused) {
                            attemptPlay(player, true);
                        }
                    }, {once: true});
                });

                [0, 250, 1200, 2500].forEach(function (delay) {
                    window.setTimeout(function () {
                        if (audio.paused) {
                            attemptPlay(player, true);
                        }
                    }, delay);
                });

                attemptPlay(player, true);
            }

            function showPlayerControls(player) {
                if (player && player.setMode) {
                    player.setMode('normal');
                }
                if (player && player.template && player.template.info) {
                    player.template.info.style.display = 'block';
                }
            }

            function resetRandomOrder(player) {
                if (!player || !player.list || !player.list.audios) {
                    return;
                }

                var order = [];
                for (var i = 0; i < player.list.audios.length; i++) {
                    order.push(i);
                }
                for (var j = order.length - 1; j > 0; j--) {
                    var randomIndex = Math.floor(Math.random() * (j + 1));
                    var item = order[j];
                    order[j] = order[randomIndex];
                    order[randomIndex] = item;
                }
                player.randomOrder = order;
            }

            function removeIntroAfterLeaving(player) {
                if (introRemoved || introIndex < 0 || !player || !player.list || player.list.index === introIndex) {
                    return;
                }

                player.removeAudio(introIndex);
                introRemoved = true;
                introIndex = -1;

                if (player.options && player.options.order === 'random') {
                    resetRandomOrder(player);
                }
            }

            function initIntro(player) {
                if (!player || !player.list || !player.list.audios || !player.addAudio || !introAudio.url) {
                    return;
                }

                metingPlayer = player;
                showPlayerControls(player);

                player.addAudio(introAudio);
                introIndex = player.list.audios.length - 1;
                player.list.switch(introIndex);
                showPlayerControls(player);

                player.on('listswitch', function () {
                    window.setTimeout(function () {
                        removeIntroAfterLeaving(player);
                    }, 0);
                });
                player.on('ended', function () {
                    window.setTimeout(function () {
                        removeIntroAfterLeaving(player);
                    }, 0);
                });

                if (autoplayEnabled) {
                    startMutedAutoplay(player);
                }

                document.addEventListener('click', function resumeMusic() {
                    if (player && player.audio && player.audio.paused) {
                        restoreAudio(player.audio);
                        attemptPlay(player, false);
                    }
                    document.removeEventListener('click', resumeMusic);
                });

                window.__liveForCodeMusic = {
                    player: player,
                    meting: metingElement
                };
            }

            initTimer = window.setInterval(function () {
                if (metingElement && metingElement.aplayer) {
                    window.clearInterval(initTimer);
                    initIntro(metingElement.aplayer);
                }
            }, 100);
        })();
    </script>
    
    <div class="wrap-right">
        <div class="setting">
            <div class="iconbox mode">
                <div class="light">
                    <span class="iconfont icon-daymode"></span>
                    <span class="icontext">浅色模式</span>
                </div>
                <div class="dark">
                    <span class="iconfont icon-nightmode-fill"></span>
                    <span class="icontext">深色模式</span>
                </div>
            </div>
            <div class="iconbox bottom">
                <div style="display: inline-block; transform: rotate(180deg);">
                    <span class="iconfont icon-top"></span>
                </div>
                <span class="icontext">跳至底部</span>
            </div>
        </div>
        <div class="iconbox set">
            <div style="display: inline-block;">
                <span class="iconfont icon-setting"></span>
            </div>
            <span class="icontext">设置</span>
        </div>
        <div class="iconbox top">
            <span class="iconfont icon-top"></span>
            <span class="icontext">返回顶部</span>
        </div>
    </div>
    <div class="loading"></div>
</div>
