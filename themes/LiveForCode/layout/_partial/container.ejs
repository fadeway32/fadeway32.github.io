<div id="container"
<% if (is_home()) { %> class="home-container"
        <% } %>
>
    <% if (is_post()) { %>
        <!-- 文章页面 -->
        <% function docAttr(value) {
            return String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        } %>
        <div id="article" data-doc-title="<%- docAttr(post.title) %>" data-doc-path="<%- url_for(post.path) %>"
             data-doc-url="<%- url_for(post.path) %>" data-doc-date="<%- date(post.date, 'YYYY-MM-DD') %>">
            <%- partial('_partial/toc') %>
            <div class="article-body">
                <%- post.content %>
                <% if (post.donate) { %>
                    <%- partial('_partial/donate') %>
                <% } %>
                <p class="end">__END__</p>
            </div>
            <div class="article-footer">
                <%- partial('_partial/suffix'), { post : post } %>
                <% if (post.categories.count() > 0) { %>
                    <div class="category">
                        <%- __('post.categories') %>
                        <% post.categories.each((category) => { %>
                            <a href="<%- url_for(category.path) %>"><%- category.name %></a>
                        <% }) %>
                    </div>
                <% } %>
                <% if (post.tags.count() > 0) { %>
                    <div class="tag">
                        <%- __('post.tags') %>
                        <% post.tags.each((tag) => { %>
                            <a href="<%- url_for(tag.path) %>"><%- tag.name %></a>
                        <% }) %>
                    </div>
                <% } %>
                <div class="article-prev-next">
                    <% if (post.prev) { %>
                        <a href="<%- url_for(post.prev.path) %>" class="prev-prefix">« </a> <%- __('post.prev') %>    <a href="<%- url_for(post.prev.path) %>" title="<%- __('post.post') %> <%- date(post.prev.date, 'YYYY-MM-DD hh:mm') %>"><%- post.prev.title %></a>
                        <br>
                    <% } %>
                    <% if (post.next) { %>
                        <a href="<%- url_for(post.next.path) %>" class="next-prefix">» </a> <%- __('post.next') %>    <a href="<%- url_for(post.next.path) %>" title="<%- __('post.post') %> <%- date(post.next.date, 'YYYY-MM-DD hh:mm') %>"><%- post.next.title %></a>
                    <% } %>
                </div>
            </div>
            <%- partial('_partial/comment') %>
        </div>
    <% } else if (is_page()) { %>
        <!-- 独立页面 -->
        <% if (page.type == 'category') { %>
            <div class="categories">
                <div class="categories-title">
                    <%- _p('category', site.categories.count()) %>
                </div>
                <div class="categories-content">
                    <%- list_categories() %>
                </div>
            </div>
        <% } else if (page.type == 'tag') { %>
            <div class="tags">
                <div class="tags-title">
                    <%- _p('tag', site.tags.count()) %>
                </div>
                <div class="tags-content">
                    <div class="tags-light">
                        <%- tagcloud({ min_font : 12, max_font : 25, amount : 300, color : true, start_color : '#CCC', end_color : '#111' }) %>
                    </div>
                    <div class="tags-dark">
                        <%- tagcloud({ min_font : 12, max_font : 25, amount : 300, color : true, start_color : '#666', end_color : '#EEE' }) %>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div id="article">
                <div class="article-body">
                    <% if (page.type == 'friend') { %>
                        <%- partial('_partial/friend') %>
                    <% } else if (page.type == '404') { %>
                        <%- partial('_partial/404') %>
                    <% } %>
                    <%- page.content %>
                    <% if (page.donate) { %>
                        <%- partial('_partial/donate') %>
                    <% } %>
                </div>
                <%- partial('_partial/comment', { post : page }) %>
            </div>
        <% } %>
    <% } else { %>
        <% if (is_home()) { %>
            <!-- 首页 -->
            <% function homeAttr(value) {
                return String(value == null ? '' : value).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            } %>
            <div class="home-portal" data-current-page="<%- page.current %>" data-total-page="<%- page.total %>"
                 data-per-page="<%- page.posts.length %>">
                <section class="home-docs" aria-label="首页文档流">
                    <div class="home-docs-head">
                        <div>
                            <h2>记录文档</h2>
                            <p>当前页 <%- page.posts.length %> 篇</p>
                        </div>
                        <span class="home-docs-page">第 <%- page.current %> / <%- page.total %> 页</span>
                    </div>
                    <div class="home-doc-grid">
                        <% page.posts.each(function(post, i) { %>
                            <%
                                const postUrl = url_for(post.path);
                                const postDate = date(post.date, 'YYYY-MM-DD');
                                const postDescription = post.description && post.description != '' ? post.description : '点击进入文档详情继续阅读。';
                                const coverPage = page.current || 1;
                                const coverSlot = String(i + 1).padStart(2, '0');
                                const postCover = `/image/home-covers/page-${coverPage}/${coverSlot}.jpg`;
                            %>
                            <article class="home-doc-card is-loading" data-doc-title="<%- homeAttr(post.title) %>"
                                     data-doc-path="<%- postUrl %>" data-doc-url="<%- postUrl %>"
                                     data-doc-date="<%- postDate %>" data-doc-cover="<%- postCover %>"
                                     data-cover-page="<%- coverPage %>" data-cover-slot="<%- coverSlot %>">
                                <a class="home-doc-cover home-doc-link" href="<%- postUrl %>"
                                   aria-label="打开 <%- homeAttr(post.title) %>">
                                    <img class="home-doc-image" src="<%- postCover %>"
                                         data-local-cover="<%- postCover %>" data-fallback="/image/header/home.jpg"
                                         loading="eager" decoding="async" alt="">
                                </a>
                                <div class="home-doc-body">
                                    <h3 class="home-doc-title">
                                        <a class="home-doc-link" href="<%- postUrl %>"><%- post.title %></a>
                                    </h3>
                                    <div class="home-doc-meta">
                                        <span><i class="iconfont icon-time"></i><%- postDate %></span>
                                        <% if (post.sticky) { %>
                                            <span class="home-doc-badge"><%- __('post.sticky') %></span>
                                        <% } %>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                </section>
            </div>
        <% } else { %>
            <!-- 归档页面、分类归档页面、标签归档页面 -->
            <div class="articles">
                <div class="articles-wrap">
                    <span class="archive-move-on"></span>
                    <span class="archive-counter">
                        <% if (is_archive()) { %>
                            <%- __('archive.default', site.posts.count()) %>
                        <% } else if (is_category()) { %>
                            <%- __('archive.category') %><span class="category"><%- page.category %></span>
                        <% } else if (is_tag) { %>
                            <%- __('archive.tag') %><span class="tag"><%- page.tag %></span>
                        <% } %>
                    </span>
                    <% let year; %>
                    <% page.posts.each(function(post, i) { %>
                        <% if (year != post.date.year()) { %>
                            <div class="archive-title">
                                <h2 class="archive-year"><%- post.date.year() %></h2>
                            </div>
                            <% year = post.date.year(); %>
                        <% } %>   
                        <div class="article">
                            <div class="article-header">
                                <h1 class="article-title"><a href="<%- url_for(post.path) %>"><span><%- post.title %></span></a></h1>
                                <div class="article-meta">
                                    <span class="article-time"><%- date(post.date, 'MM-DD') %></span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% } %>    
        <%- partial('_partial/pagination') %>
    <% } %>
</div>
